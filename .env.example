# llm-tracelab production environment example.
# Copy to .env for docker compose, then replace every production secret.

# Compose host ports.
LLM_TRACELAB_HOST_SERVER_PORT=8080
LLM_TRACELAB_HOST_MONITOR_PORT=8081
LLM_TRACELAB_POSTGRES_PORT=5432

# Application runtime.
LLM_TRACELAB_CONFIG=/app/config/config.yaml
LLM_TRACELAB_SERVER_PORT=8080
LLM_TRACELAB_MONITOR_PORT=8081
LLM_TRACELAB_OUTPUT_DIR=/app/data/traces
LLM_TRACELAB_TRACE_OUTPUT_DIR=/app/data/traces
LLM_TRACELAB_MASK_KEY=true

# Postgres application/auth database.
POSTGRES_DB=llm_tracelab
POSTGRES_USER=llm_tracelab
POSTGRES_PASSWORD=change-me-strong-password
LLM_TRACELAB_DATABASE_DRIVER=postgres
LLM_TRACELAB_DATABASE_DSN=postgres://llm_tracelab:change-me-strong-password@postgres:5432/llm_tracelab?sslmode=disable
LLM_TRACELAB_DATABASE_MAX_OPEN_CONNS=16
LLM_TRACELAB_DATABASE_MAX_IDLE_CONNS=8
LLM_TRACELAB_DATABASE_AUTO_MIGRATE=true

# Auth and MCP.
LLM_TRACELAB_AUTH_SESSION_TTL=24h
LLM_TRACELAB_MCP_ENABLED=true
LLM_TRACELAB_MCP_PATH=/mcp

# Local Responses server-mode.
LLM_TRACELAB_RESPONSES_ENABLED=true
LLM_TRACELAB_RESPONSES_DEFAULT_MODEL=gpt-4o-mini
LLM_TRACELAB_RESPONSES_FORCE_STORE=true
LLM_TRACELAB_RESPONSES_MAX_REQUEST_BODY_BYTES=10485760
LLM_TRACELAB_RESPONSES_PATH=/v1/responses
LLM_TRACELAB_RESPONSES_AUTO_COMPACT=true
LLM_TRACELAB_RESPONSES_COMPACT_HISTORY_ITEM_THRESHOLD=80

# Function executors are disabled by default for production.
LLM_TRACELAB_RESPONSES_FUNCTION_EXECUTORS_ENABLED=false
LLM_TRACELAB_RESPONSES_FUNCTION_EXECUTORS_TIMEOUT=2s
LLM_TRACELAB_RESPONSES_FUNCTION_EXECUTORS_MAX_RESULT_BYTES=65536
LLM_TRACELAB_RESPONSES_FUNCTION_EXECUTORS_REDACT_ARGUMENTS=true
LLM_TRACELAB_RESPONSES_FUNCTION_EXECUTORS_REDACT_OUTPUT=true

# First upstream bootstrap target. After import, manage channels/models in Monitor.
LLM_TRACELAB_BOOTSTRAP_UPSTREAM_BASE_URL=http://host.docker.internal:8000/v1
LLM_TRACELAB_BOOTSTRAP_UPSTREAM_API_KEY=change-me-provider-token

# Legacy single-upstream overrides. Leave empty unless migrating an old setup.
LLM_TRACELAB_UPSTREAM_BASE_URL=
LLM_TRACELAB_UPSTREAM_API_KEY=
LLM_TRACELAB_UPSTREAM_PROVIDER_PRESET=
LLM_TRACELAB_UPSTREAM_API_TYPE=
LLM_TRACELAB_UPSTREAM_MODE=
LLM_TRACELAB_UPSTREAM_PROTOCOL_FAMILY=
LLM_TRACELAB_UPSTREAM_ROUTING_PROFILE=
LLM_TRACELAB_UPSTREAM_API_VERSION=
LLM_TRACELAB_UPSTREAM_DEPLOYMENT=
LLM_TRACELAB_UPSTREAM_PROJECT=
LLM_TRACELAB_UPSTREAM_LOCATION=
LLM_TRACELAB_UPSTREAM_MODEL_RESOURCE=

# Optional startup provider probe.
LLM_TRACELAB_PROVIDER_PROBE_STARTUP_FILL=false
LLM_TRACELAB_PROVIDER_PROBE_TIMEOUT=3s

# Optional hosted web_search through the compose searxng profile.
LLM_TRACELAB_TOOLS_WEB_SEARCH_ENABLED=false
LLM_TRACELAB_TOOLS_WEB_SEARCH_PROVIDER=searxng
LLM_TRACELAB_TOOLS_WEB_SEARCH_MAX_RESULTS=5
LLM_TRACELAB_TOOLS_WEB_SEARCH_BASE_URL=http://searxng:8080
LLM_TRACELAB_TOOLS_WEB_SEARCH_TIMEOUT_MS=5000
LLM_TRACELAB_TOOLS_WEB_SEARCH_USER_AGENT=llm-tracelab/production

# SearXNG compose profile settings.
SEARXNG_BASE_URL=http://localhost:8088/
SEARXNG_INSTANCE_NAME=llm-tracelab-searxng
SEARXNG_PORT=8088

# Optional Docker build network/proxy knobs.
DOCKER_BUILD_GOPROXY=
DOCKER_BUILD_GOSUMDB=
DOCKER_BUILD_HTTP_PROXY=
DOCKER_BUILD_HTTPS_PROXY=
DOCKER_BUILD_NO_PROXY=
DOCKER_BUILD_http_proxy=
DOCKER_BUILD_https_proxy=
DOCKER_BUILD_no_proxy=
