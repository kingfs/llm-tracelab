# llm-tracelab deployment environment example.
# Copy to .env for docker compose, then replace production secrets.

# Public host ports exposed by docker compose.
LLM_TRACELAB_HOST_SERVER_PORT=8080
LLM_TRACELAB_HOST_MONITOR_PORT=8081
LLM_TRACELAB_POSTGRES_PORT=5432

# Postgres service and application DSN.
POSTGRES_DB=llm_tracelab
POSTGRES_USER=llm_tracelab
POSTGRES_PASSWORD=change-me-strong-password
LLM_TRACELAB_DATABASE_DSN=postgres://llm_tracelab:change-me-strong-password@postgres:5432/llm_tracelab?sslmode=disable

# Optional first provider bootstrap. Leave empty to start only the Web UI.
LLM_TRACELAB_BOOTSTRAP_UPSTREAM_BASE_URL=
LLM_TRACELAB_BOOTSTRAP_UPSTREAM_API_KEY=

# Optional hosted web_search through the compose searxng profile.
LLM_TRACELAB_TOOLS_WEB_SEARCH_ENABLED=false
SEARXNG_BASE_URL=http://localhost:8088/
SEARXNG_INSTANCE_NAME=llm-tracelab-searxng
SEARXNG_PORT=8088
